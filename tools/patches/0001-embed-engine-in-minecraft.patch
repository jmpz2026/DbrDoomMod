+++ b/m/Menu.java	2026-08-16 10:11:22.122053700 -0500
@@ -1412,6 +1412,20 @@
             break;
         }
 
+        /*
+         * DbrDoomMod: an IWAD can carry fewer episodes than its game mode
+         * implies. The mode is decided by the file's name, so a trimmed WAD
+         * still claims every episode, and choosing one whose maps are absent
+         * drops the player into a failed load with no explanation.
+         *
+         * Trim from the top down until the last listed episode is one that
+         * actually has a first map. General on purpose: it reads the WAD rather
+         * than assuming anything about which WAD is present.
+         */
+        while (EpiDef.numitems > 1
+                && DOOM.wadLoader.CheckNumForName("E" + EpiDef.numitems + "M1") < 0) {
+            EpiDef.numitems--;
+        }
     }
 
     
